{
  "name": "whatsapp-central",
  "version": "1.0.0",
  "private": true,
  "description": "Whats AI: personal local WhatsApp workspace with AI, CRM and QR pairing",
  "scripts": {
    "start": "node scripts/open-central.cjs",
    "stop": "node scripts/stop-central.cjs",
    "serve": "node server.cjs",
    "test": "node --test tests/*.test.cjs",
    "configure": "node scripts/configure.cjs",
    "shortcut": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/shortcut.ps1",
    "demo": "node scripts/demo.cjs",
    "test:e2e": "playwright test",
    "rag:configurar": "node scripts/rag-configurar.cjs",
    "rag:testar": "node scripts/rag-testar.cjs",
    "test:e2e:rag": "playwright test tests/e2e/rag.spec.cjs",
    "codegen": "node scripts/codegen.cjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.1"
  }
}
